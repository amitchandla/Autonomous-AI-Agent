# ---- Supabase ----
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the SERVICE ROLE key on the backend (never expose this client-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- AI Script Generation ----
# Set to "openai" or "mock". Use "mock" for local testing with zero API cost.
AI_PROVIDER=mock
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# ---- YouTube OAuth (from Google Cloud Console) ----
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:8000/oauth/youtube/callback

# ---- App ----
LOCAL_RENDER_DIR=./rendered_videos
SCHEDULER_POLL_SECONDS=60

# ---- Deployment / cron (Phase 5) ----
# Set to "false" in production if an external cron (Supabase Cron or Vercel
# Cron) calls POST /cron/run-due-schedules instead of relying on the
# in-process APScheduler loop. Leave "true" for local development.
ENABLE_INTERNAL_SCHEDULER=true
# Shared secret the external cron must send as the `x-cron-secret` header.
# Generate one with: openssl rand -hex 32
CRON_SECRET=
