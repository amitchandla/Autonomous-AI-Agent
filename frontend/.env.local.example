# ---- Supabase (public — safe for the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- YouTube OAuth (server-side only — do NOT prefix with NEXT_PUBLIC_) ----
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# ---- Supabase (server-only — needed by the Stripe webhook to bypass RLS) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PRICE_ID_MONTHLY=price_your-monthly-price-id
STRIPE_PRICE_ID_YEARLY=price_your-yearly-price-id

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Cron (Phase 5) ----
# Vercel auto-generates and injects this for registered cron routes once you
# add it as an env var here — generate with: openssl rand -hex 32
CRON_SECRET=
# URL of the deployed Python backend (Render/Railway/Heroku), no trailing slash.
BACKEND_URL=https://your-backend.onrender.com
# Must match CRON_SECRET in the backend's own .env — this is a SEPARATE
# secret from the one above; it authenticates frontend -> backend, not
# Vercel -> frontend.
BACKEND_CRON_SECRET=
